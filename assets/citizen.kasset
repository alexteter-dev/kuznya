  {
   "code": "\"\"\"wikipowers: parahuman powers and classifications as listed on the Worm wiki (worm.fandom.com).\nGenerated by build.py from data/canon_research.json; summaries are paraphrased.\"\"\"\nEXAMPLES = [\n {\n  \"cape\": \"Scion\",\n  \"cls\": \"Blaster\",\n  \"rating\": 15,\n  \"summary\": \"Golden man with flight, near-total invulnerability and beams that erase anything, including other powers' effects.\",\n  \"tier\": \"overpowered\"\n },\n {\n  \"cape\": \"Eidolon\",\n  \"cls\": \"Trump\",\n  \"rating\": 12,\n  \"summary\": \"Holds three or four powers of his choice at once, swapping them as the situation demands.\",\n  \"tier\": \"overpowered\"\n },\n {\n  \"cape\": \"Alexandria\",\n  \"cls\": \"Brute\",\n  \"rating\": 10,\n  \"summary\": \"Unbreakable time-locked body with flight, vast strength and a perfect-memory accelerated mind.\",\n  \"tier\": \"overpowered\"\n },\n {\n  \"cape\": \"Legend\",\n  \"cls\": \"Blaster\",\n  \"rating\": 10,\n  \"summary\": \"Flies at extreme speed while firing lasers that bend, split and carry effects such as heat or cold.\",\n  \"tier\": \"overpowered\"\n },\n {\n  \"cape\": \"Contessa\",\n  \"cls\": \"Thinker\",\n  \"rating\": 12,\n  \"summary\": \"Asks how to achieve a goal and is shown every step needed, then carries them out flawlessly.\",\n  \"tier\": \"overpowered\"\n },\n {\n  \"cape\": \"Glaistig Uaine\",\n  \"cls\": \"Trump\",\n  \"rating\": 12,\n  \"summary\": \"Harvests the powers of the dead and calls up three of them at a time as ghostly servants.\",\n  \"tier\": \"overpowered\"\n },\n {\n  \"cape\": \"Siberian\",\n  \"cls\": \"Master\",\n  \"rating\": 10,\n  \"summary\": \"Projects an untouchable striped woman who ignores all physics and tears through anything; the frail creator hides nearby.\",\n  \"tier\": \"overpowered\"\n },\n {\n  \"cape\": \"Nilbog\",\n  \"cls\": \"Master\",\n  \"rating\": 10,\n  \"summary\": \"Reshapes biomass into loyal goblin-like creatures that he can recycle and rebuild endlessly.\",\n  \"tier\": \"overpowered\"\n },\n {\n  \"cape\": \"Sleeper\",\n  \"cls\": \"Shaker\",\n  \"rating\": 12,\n  \"summary\": \"A threat so severe that whole regions are simply abandoned to him; details unknown.\",\n  \"tier\": \"overpowered\"\n },\n {\n  \"cape\": \"Ash Beast\",\n  \"cls\": \"Breaker\",\n  \"rating\": 10,\n  \"summary\": \"Walks at the centre of a continuous matter-to-energy explosion that never stops.\",\n  \"tier\": \"overpowered\"\n },\n {\n  \"cape\": \"Gray Boy\",\n  \"cls\": \"Shaker\",\n  \"rating\": 10,\n  \"summary\": \"Traps victims in small bubbles of time that loop forever, and resets himself when harmed.\",\n  \"tier\": \"overpowered\"\n },\n {\n  \"cape\": \"Dragon\",\n  \"cls\": \"Tinker\",\n  \"rating\": 9,\n  \"summary\": \"Understands and improves on any other tinker's work, fielding many remote-piloted war machines.\",\n  \"tier\": \"high\"\n },\n {\n  \"cape\": \"Narwhal\",\n  \"cls\": \"Shaker\",\n  \"rating\": 9,\n  \"summary\": \"Makes razor-thin forcefields in any shape, even inside objects, and wears them as armour.\",\n  \"tier\": \"high\"\n },\n {\n  \"cape\": \"Chevalier\",\n  \"cls\": \"Striker\",\n  \"rating\": 8,\n  \"summary\": \"Merges objects together so the result keeps the best traits of each, such as a cannon-sword light as a knife; also sees power-shadows.\",\n  \"tier\": \"high\"\n },\n {\n  \"cape\": \"Myrddin\",\n  \"cls\": \"Shaker\",\n  \"rating\": 8,\n  \"summary\": \"Draws on several pocket dimensions to launch blasts, store things and banish targets, styled as wizardry.\",\n  \"tier\": \"high\"\n },\n {\n  \"cape\": \"Jack Slash\",\n  \"cls\": \"Blaster\",\n  \"rating\": 5,\n  \"summary\": \"Any blade edge he holds cuts at any distance along his swing; a hidden sense lets him read other parahumans.\",\n  \"tier\": \"high\"\n },\n {\n  \"cape\": \"Bonesaw\",\n  \"cls\": \"Tinker\",\n  \"rating\": 8,\n  \"summary\": \"Biological tinker: surgery, plagues, grafted cyborg bodyguards and implants that keep people alive through anything.\",\n  \"tier\": \"high\"\n },\n {\n  \"cape\": \"Crawler\",\n  \"cls\": \"Brute\",\n  \"rating\": 9,\n  \"summary\": \"Regenerates and permanently adapts to whatever injures him, becoming a huge armoured beast that spits acid.\",\n  \"tier\": \"high\"\n },\n {\n  \"cape\": \"Shatterbird\",\n  \"cls\": \"Shaker\",\n  \"rating\": 9,\n  \"summary\": \"Controls glass and silicon; her opening scream shatters every pane and screen across a city.\",\n  \"tier\": \"high\"\n },\n {\n  \"cape\": \"Mannequin\",\n  \"cls\": \"Tinker\",\n  \"rating\": 7,\n  \"summary\": \"Sealed his organs inside a jointed ceramic body with blades and chains; specialises in closed life-support systems.\",\n  \"tier\": \"high\"\n },\n {\n  \"cape\": \"Burnscar\",\n  \"cls\": \"Shaker\",\n  \"rating\": 7,\n  \"summary\": \"Creates and shapes fire and teleports between flames; the more fire around, the less restraint she has.\",\n  \"tier\": \"high\"\n },\n {\n  \"cape\": \"Cherish\",\n  \"cls\": \"Master\",\n  \"rating\": 7,\n  \"summary\": \"Senses emotions across a whole city and can force feelings on people at range.\",\n  \"tier\": \"high\"\n },\n {\n  \"cape\": \"Hatchet Face\",\n  \"cls\": \"Trump\",\n  \"rating\": 7,\n  \"summary\": \"Strong, tough killer who shuts off the powers of anyone near him.\",\n  \"tier\": \"high\"\n },\n {\n  \"cape\": \"Heartbreaker\",\n  \"cls\": \"Master\",\n  \"rating\": 8,\n  \"summary\": \"Reaches into people's emotions and makes them permanently love or fear him.\",\n  \"tier\": \"high\"\n },\n {\n  \"cape\": \"Marquis\",\n  \"cls\": \"Shaker\",\n  \"rating\": 7,\n  \"summary\": \"Shapes and grows bone, his own or any exposed bone nearby, into weapons, armour and structures.\",\n  \"tier\": \"high\"\n },\n {\n  \"cape\": \"Butcher\",\n  \"cls\": \"Brute\",\n  \"rating\": 9,\n  \"summary\": \"Strength, toughness, teleport, pain infliction and more, inherited along with the minds of every previous Butcher by whoever kills the current one.\",\n  \"tier\": \"high\"\n },\n {\n  \"cape\": \"Accord\",\n  \"cls\": \"Thinker\",\n  \"rating\": 7,\n  \"summary\": \"Becomes smarter the more complex the problem, producing flawless plans for anything from a murder to ending world hunger.\",\n  \"tier\": \"high\"\n },\n {\n  \"cape\": \"Number Man\",\n  \"cls\": \"Thinker\",\n  \"rating\": 8,\n  \"summary\": \"Sees the mathematics behind everything, giving perfect aim, movement and financial mastery.\",\n  \"tier\": \"high\"\n },\n {\n  \"cape\": \"Flechette\",\n  \"cls\": \"Striker\",\n  \"rating\": 6,\n  \"summary\": \"Charges objects so they pierce anything and ignore gravity and friction, with a perfect sense of timing and angles.\",\n  \"tier\": \"high\"\n },\n {\n  \"cape\": \"Weld\",\n  \"cls\": \"Brute\",\n  \"rating\": 6,\n  \"summary\": \"Living metal body that needs no food or air and absorbs any metal it touches, sometimes by accident.\",\n  \"tier\": \"mid\"\n },\n {\n  \"cape\": \"Sundancer\",\n  \"cls\": \"Blaster\",\n  \"rating\": 8,\n  \"summary\": \"Summons a small sun she can move and enlarge.\",\n  \"tier\": \"high\"\n },\n {\n  \"cape\": \"Noelle\",\n  \"cls\": \"Master\",\n  \"rating\": 10,\n  \"summary\": \"Monstrous lower body that absorbs people and spits out twisted, hostile clones with variant powers.\",\n  \"tier\": \"overpowered\"\n },\n {\n  \"cape\": \"Bastion\",\n  \"cls\": \"Shaker\",\n  \"rating\": 7,\n  \"summary\": \"Builds varied forcefields and deflecting walls.\",\n  \"tier\": \"mid\"\n },\n {\n  \"cape\": \"Mouse Protector\",\n  \"cls\": \"Mover\",\n  \"rating\": 4,\n  \"summary\": \"Tags a person or object by touch and can later teleport to it; fights with sword, shield and bad puns.\",\n  \"tier\": \"mid\"\n },\n {\n  \"cape\": \"Ravager\",\n  \"cls\": \"Striker\",\n  \"rating\": 5,\n  \"summary\": \"Wounds she inflicts fester and refuse to heal.\",\n  \"tier\": \"mid\"\n },\n {\n  \"cape\": \"Strider\",\n  \"cls\": \"Mover\",\n  \"rating\": 6,\n  \"summary\": \"Teleports large groups across great distances.\",\n  \"tier\": \"mid\"\n },\n {\n  \"cape\": \"Cache\",\n  \"cls\": \"Shaker\",\n  \"rating\": 5,\n  \"summary\": \"Shunts objects into an extradimensional pocket and brings them back later.\",\n  \"tier\": \"mid\"\n },\n {\n  \"cape\": \"Ursa Aurora\",\n  \"cls\": \"Master\",\n  \"rating\": 5,\n  \"summary\": \"Creates living forcefields shaped like bears.\",\n  \"tier\": \"mid\"\n },\n {\n  \"cape\": \"Prism\",\n  \"cls\": \"Master\",\n  \"rating\": 5,\n  \"summary\": \"Divides into three copies and recombines them, gaining strength when they merge.\",\n  \"tier\": \"mid\"\n },\n {\n  \"cape\": \"Raymancer\",\n  \"cls\": \"Blaster\",\n  \"rating\": 6,\n  \"summary\": \"Makes countless small light blasts and focuses them into one devastating shot.\",\n  \"tier\": \"mid\"\n },\n {\n  \"cape\": \"Tecton\",\n  \"cls\": \"Tinker\",\n  \"rating\": 5,\n  \"summary\": \"Seismic and architectural tinker in power armour whose gauntlets crack ground and drop buildings.\",\n  \"tier\": \"mid\"\n },\n {\n  \"cape\": \"Wanton\",\n  \"cls\": \"Breaker\",\n  \"rating\": 5,\n  \"summary\": \"Becomes a localised whirlwind of telekinetic force.\",\n  \"tier\": \"mid\"\n },\n {\n  \"cape\": \"Grace\",\n  \"cls\": \"Striker\",\n  \"rating\": 4,\n  \"summary\": \"Makes chosen body parts invulnerable and hits with boosted force, with enhanced agility.\",\n  \"tier\": \"mid\"\n },\n {\n  \"cape\": \"Gully\",\n  \"cls\": \"Shaker\",\n  \"rating\": 6,\n  \"summary\": \"Moves and reshapes earth and rock.\",\n  \"tier\": \"mid\"\n },\n {\n  \"cape\": \"Hunch\",\n  \"cls\": \"Thinker\",\n  \"rating\": 3,\n  \"summary\": \"Gets vague, not always reliable feelings about what is about to happen.\",\n  \"tier\": \"low\"\n },\n {\n  \"cape\": \"Scapegoat\",\n  \"cls\": \"Striker\",\n  \"rating\": 4,\n  \"summary\": \"Takes others' injuries onto himself temporarily and can pass them to someone he touches.\",\n  \"tier\": \"mid\"\n },\n {\n  \"cape\": \"Shamrock\",\n  \"cls\": \"Thinker\",\n  \"rating\": 4,\n  \"summary\": \"Tiny telekinetic nudges guided by subconscious foresight add up to uncanny luck.\",\n  \"tier\": \"mid\"\n },\n {\n  \"cape\": \"Matryoshka\",\n  \"cls\": \"Changer\",\n  \"rating\": 5,\n  \"summary\": \"Unfolds into ribbons that wrap around people and fold them inside her, taking on their traits.\",\n  \"tier\": \"mid\"\n },\n {\n  \"cape\": \"Garotte\",\n  \"cls\": \"Changer\",\n  \"rating\": 7,\n  \"summary\": \"A face on a mass of thin tendrils that reflexively strangle anything they touch.\",\n  \"tier\": \"high\"\n },\n {\n  \"cape\": \"Blasto\",\n  \"cls\": \"Tinker\",\n  \"rating\": 6,\n  \"summary\": \"Grows engineered plant and plant-animal hybrid creatures.\",\n  \"tier\": \"mid\"\n },\n {\n  \"cape\": \"Barker\",\n  \"cls\": \"Blaster\",\n  \"rating\": 3,\n  \"summary\": \"Sounds he makes turn into gas with varied effects, usually concussive.\",\n  \"tier\": \"low\"\n },\n {\n  \"cape\": \"Biter\",\n  \"cls\": \"Changer\",\n  \"rating\": 3,\n  \"summary\": \"Stretches and enlarges parts of his body, most often a huge trap-like jaw.\",\n  \"tier\": \"low\"\n },\n {\n  \"cape\": \"Imp\",\n  \"cls\": \"Stranger\",\n  \"rating\": 5,\n  \"summary\": \"People cannot notice or remember her while her power is on.\",\n  \"tier\": \"mid\"\n },\n {\n  \"cape\": \"Scrub\",\n  \"cls\": \"Blaster\",\n  \"rating\": 5,\n  \"summary\": \"Uncontrolled flashes around him annihilate chunks of matter at random spots.\",\n  \"tier\": \"mid\"\n },\n {\n  \"cape\": \"Trickster\",\n  \"cls\": \"Mover\",\n  \"rating\": 5,\n  \"summary\": \"Swaps places between two objects or people of similar mass in his sight.\",\n  \"tier\": \"mid\"\n },\n {\n  \"cape\": \"Perdition\",\n  \"cls\": \"Mover\",\n  \"rating\": 5,\n  \"summary\": \"Rewinds a single target a few seconds back in time.\",\n  \"tier\": \"mid\"\n },\n {\n  \"cape\": \"Oliver\",\n  \"cls\": \"Changer\",\n  \"rating\": 1,\n  \"summary\": \"Body slowly shifts to become more attractive to whoever is around; no combat use.\",\n  \"tier\": \"trash\"\n },\n {\n  \"cape\": \"Canary\",\n  \"cls\": \"Master\",\n  \"rating\": 8,\n  \"summary\": \"Singing voice makes listeners extremely suggestible; has feathers in her hair.\",\n  \"tier\": \"high\"\n },\n {\n  \"cape\": \"Lizardtail\",\n  \"cls\": \"Shaker\",\n  \"rating\": 3,\n  \"summary\": \"Gives off an aura that slowly heals and steadies people around him.\",\n  \"tier\": \"low\"\n },\n {\n  \"cape\": \"Rime\",\n  \"cls\": \"Blaster\",\n  \"rating\": 6,\n  \"summary\": \"Fires blasts that leave growing ice structures; flies.\",\n  \"tier\": \"mid\"\n },\n {\n  \"cape\": \"Exalt\",\n  \"cls\": \"Shaker\",\n  \"rating\": 6,\n  \"summary\": \"Aerokinetic and telekinetic who charges up for bigger releases.\",\n  \"tier\": \"mid\"\n },\n {\n  \"cape\": \"Revel\",\n  \"cls\": \"Blaster\",\n  \"rating\": 7,\n  \"summary\": \"Lantern absorbs energy attacks and releases them as homing orbs.\",\n  \"tier\": \"mid\"\n },\n {\n  \"cape\": \"Golem\",\n  \"cls\": \"Shaker\",\n  \"rating\": 6,\n  \"summary\": \"Pushes a limb into a surface and a giant copy made of that material emerges from a matching surface nearby.\",\n  \"tier\": \"mid\"\n },\n {\n  \"cape\": \"Cuff\",\n  \"cls\": \"Striker\",\n  \"rating\": 4,\n  \"summary\": \"Bends and shapes metal by touch, with strength when using it.\",\n  \"tier\": \"mid\"\n },\n {\n  \"cape\": \"Foil\",\n  \"cls\": \"Striker\",\n  \"rating\": 6,\n  \"summary\": \"Later name of Flechette; same all-piercing charge.\",\n  \"tier\": \"high\"\n },\n {\n  \"cape\": \"Annex\",\n  \"cls\": \"Breaker\",\n  \"rating\": 4,\n  \"summary\": \"Merges into solid surfaces and reshapes them from inside.\",\n  \"tier\": \"mid\"\n },\n {\n  \"cape\": \"Kudzu\",\n  \"cls\": \"Master\",\n  \"rating\": 4,\n  \"summary\": \"Splits into several weaker copies of herself.\",\n  \"tier\": \"low\"\n },\n {\n  \"cape\": \"Whirlygig\",\n  \"cls\": \"Shaker\",\n  \"rating\": 3,\n  \"summary\": \"Orbits nearby loose objects around herself.\",\n  \"tier\": \"low\"\n },\n {\n  \"cape\": \"Trainwreck\",\n  \"cls\": \"Tinker\",\n  \"rating\": 3,\n  \"summary\": \"Crude steam armour around a mostly shapeless body.\",\n  \"tier\": \"low\"\n },\n {\n  \"cape\": \"Leet\",\n  \"cls\": \"Tinker\",\n  \"rating\": 2,\n  \"summary\": \"Can build anything once; repeats tend to explode.\",\n  \"tier\": \"low\"\n },\n {\n  \"cape\": \"Skidmark\",\n  \"cls\": \"Shaker\",\n  \"rating\": 2,\n  \"summary\": \"Lays strips on the ground that shove whatever crosses them.\",\n  \"tier\": \"low\"\n },\n {\n  \"cape\": \"Chubster\",\n  \"cls\": \"Brute\",\n  \"rating\": 3,\n  \"summary\": \"Fat man who is very hard to move or injure.\",\n  \"tier\": \"low\"\n },\n {\n  \"cape\": \"Über\",\n  \"cls\": \"Thinker\",\n  \"rating\": 3,\n  \"summary\": \"Temporary mastery of whichever skill he focuses on.\",\n  \"tier\": \"low\"\n },\n {\n  \"cape\": \"Nice Guy\",\n  \"cls\": \"Stranger\",\n  \"rating\": 5,\n  \"summary\": \"Everyone near him believes he is harmless and friendly no matter what he does.\",\n  \"tier\": \"mid\"\n },\n {\n  \"cape\": \"Hemorrhagia\",\n  \"cls\": \"Striker\",\n  \"rating\": 5,\n  \"summary\": \"Controls her own blood, hardening it into blades and scabs, and heals from it.\",\n  \"tier\": \"mid\"\n },\n {\n  \"cape\": \"Animos\",\n  \"cls\": \"Changer\",\n  \"rating\": 5,\n  \"summary\": \"Turns into a beast whose roar briefly suppresses powers.\",\n  \"tier\": \"mid\"\n },\n {\n  \"cape\": \"Spree\",\n  \"cls\": \"Master\",\n  \"rating\": 5,\n  \"summary\": \"Spawns streams of short-lived, increasingly stupid clones of himself.\",\n  \"tier\": \"mid\"\n },\n {\n  \"cape\": \"Vex\",\n  \"cls\": \"Shaker\",\n  \"rating\": 4,\n  \"summary\": \"Fills the air with tiny sharp forcefields.\",\n  \"tier\": \"mid\"\n },\n {\n  \"cape\": \"Damsel of Distress\",\n  \"cls\": \"Blaster\",\n  \"rating\": 6,\n  \"summary\": \"Hands release uncontrollable blasts that warp and annihilate space, with fierce recoil.\",\n  \"tier\": \"mid\"\n },\n {\n  \"cape\": \"Citrine\",\n  \"cls\": \"Shaker\",\n  \"rating\": 6,\n  \"summary\": \"Tunes a yellow-lit area to alter one physical or power-related property inside it.\",\n  \"tier\": \"mid\"\n },\n {\n  \"cape\": \"Othello\",\n  \"cls\": \"Stranger\",\n  \"rating\": 5,\n  \"summary\": \"Has an invisible mirror self that only he perceives and that can act on the world.\",\n  \"tier\": \"mid\"\n },\n {\n  \"cape\": \"Grumman\",\n  \"cls\": \"Blaster\",\n  \"rating\": 2,\n  \"summary\": \"Minor cape with a weak shockwave push.\",\n  \"tier\": \"trash\"\n },\n {\n  \"cape\": \"Fume Hood\",\n  \"cls\": \"Blaster\",\n  \"rating\": 4,\n  \"summary\": \"Throws orbs that burst into noxious gas.\",\n  \"tier\": \"low\"\n },\n {\n  \"cape\": \"Tribute\",\n  \"cls\": \"Trump\",\n  \"rating\": 3,\n  \"summary\": \"Lends small boosts of strength and toughness to several allies at once.\",\n  \"tier\": \"low\"\n }\n]\nCLASSES = [\n {\n  \"cls\": \"Mover\",\n  \"definition\": \"Powers that give unusual speed or ways of getting around, for the user or others.\",\n  \"typical_triggers\": \"A need to escape: being trapped, chased, hounded or stuck in a rut, with the form of the threat shaping the form of travel.\"\n },\n {\n  \"cls\": \"Shaker\",\n  \"definition\": \"Powers that act over an area and reshape the battlefield.\",\n  \"typical_triggers\": \"Danger from the surroundings rather than a person: disasters, weather, collapse, fire, being lost in a hostile place.\"\n },\n {\n  \"cls\": \"Brute\",\n  \"definition\": \"Powers giving enhanced strength, durability or both; every Brute has some self-protection.\",\n  \"typical_triggers\": \"Physical harm suffered directly: beatings, injuries, pain, a body pushed past its limit.\"\n },\n {\n  \"cls\": \"Breaker\",\n  \"definition\": \"Powers that shift the user into an altered state where different rules apply, sometimes permanently.\",\n  \"typical_triggers\": \"Hard-to-define crises where body and mind are inseparably bound up, often involving drugs, illness, poison or contradictory feelings.\"\n },\n {\n  \"cls\": \"Master\",\n  \"definition\": \"Powers that control other beings or create minions.\",\n  \"typical_triggers\": \"Loneliness, exile, abandonment, betrayal or the loss of a loved one; one lost bond tends to give one minion, isolation from society gives many.\"\n },\n {\n  \"cls\": \"Tinker\",\n  \"definition\": \"Powers that let the user design and build technology far beyond current science, usually within a specialty.\",\n  \"typical_triggers\": \"Long-running problems with no resolution that finally come to a head; stress stretched over months or years rather than a single moment.\"\n },\n {\n  \"cls\": \"Blaster\",\n  \"definition\": \"Powers that attack at range.\",\n  \"typical_triggers\": \"A threat seen coming from a distance, or a need to strike something out of reach; fear and anger aimed at a target.\"\n },\n {\n  \"cls\": \"Thinker\",\n  \"definition\": \"Powers of knowledge, perception, skill or enhanced thought.\",\n  \"typical_triggers\": \"Intense mental and emotional strain peaking quickly: crushing revelations, dread, guilt, a crisis where knowing more would have saved someone.\"\n },\n {\n  \"cls\": \"Striker\",\n  \"definition\": \"Powers that work by touch or at melee range.\",\n  \"typical_triggers\": \"A single threat right in the person's face: an attacker or object at arm's length.\"\n },\n {\n  \"cls\": \"Changer\",\n  \"definition\": \"Powers that alter the user's own body or appearance.\",\n  \"typical_triggers\": \"Struggles over identity, body image or suffocating social expectations.\"\n },\n {\n  \"cls\": \"Trump\",\n  \"definition\": \"Powers that act on powers: granting, copying, boosting, weakening or removing them, or choosing between many. Only a few percent of parahumans qualify.\",\n  \"typical_triggers\": \"A trigger in which other people's powers are central to the crisis.\"\n },\n {\n  \"cls\": \"Stranger\",\n  \"definition\": \"Powers of stealth, deception and infiltration.\",\n  \"typical_triggers\": \"Threats to mental or social safety, especially unwanted attention or pressure from a person, a crowd or the world.\"\n }\n]\n",
   "name": "wikipowers",
   "identity": "xgOisvNOUgBdlFarA44uxg"
  }
 ],
